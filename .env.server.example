# .env.server.example
# セルフホスト (VPS) 運用時の環境変数テンプレート。
# 使用時は .env.server にリネームし、実値を記入すること (git管理外)。
# ecosystem.archimagna.cjs が起動時に読み込む。

# DynamoDB 接続 (README「開発者向け」のIAM設定を参照)
AWS_REGION=ap-northeast-1
DYNAMODB_TABLE=archimagna
AWS_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxx
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# サーバーポート (DungeonMarket と同居する場合は既定の 3100 のまま)
PORT=3100
